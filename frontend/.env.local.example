# Get this from https://dashboard.privy.io — create an app, copy its App ID.
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Set after running DeployHandshake.s.sol
NEXT_PUBLIC_HANDSHAKE_ADDRESS=0x...

# Set after running DeployResolver.s.sol (used only to link out to the
# resolver on Etherscan from the Deal Passport page; the frontend itself
# talks to Handshake directly for speed/reliability during the demo).
NEXT_PUBLIC_RESOLVER_ADDRESS=0x...

NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
