# Note: verify this against developers.circle.com before deploying —
# testnet addresses have been known to change.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
PRIVATE_KEY=0xyour_deployer_private_key
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
ETHERSCAN_API_KEY=your_etherscan_v2_api_key

# --- Filled in after DeployHandshake.s.sol ---
HANDSHAKE_ADDRESS=

# --- Filled in after DeployResolver.s.sol ---
RESOLVER_ADDRESS=

# --- For SetupENS.s.sol only ---
# Register handshake.eth on Sepolia via https://app.ens.domains first (see
# comments in SetupENS.s.sol for why this step can't be scripted). Then
# verify the current ENSv2 registry address at
# https://docs.ens.domains/learn/deployments before setting this — ENSv2 is
# still in beta and addresses may change.
REGISTRY_ADDRESS=
PARENT_NAME=handshake.eth
